      "steps": [
        { "call": "quote", "input": {}, "expect": [
          ["rejections[productId=464306].code", "=", "BRAND_EXCLUDED"],
          ["rejections[productId=463380].code", "=", "SUBTYPE_MISMATCH"],
          ["rejections[productId=463203].code", "=", "SUBTYPE_MISMATCH"],
          ["offers[0].lines[*].productId", "contains", "462775"], ["offers[0].lines[*].productId", "contains", "469363"],
