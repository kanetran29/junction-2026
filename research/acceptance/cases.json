      ]
    },
    {
      "id": "AC10", "title": "After the Sunday 17:00 cut-off nothing is offered", "rubric": ["exceptions 15", "controls 20"],
      "given": { "clock": "2026-11-15T17:05:00+02:00", "draft": { "category": "10400", "claims": ["FREE_FROM_LACTOSE"], "quantity": { "value": 100, "unit": "l" }, "deliverBy": "2026-11-16" } },
      "steps": [{ "call": "quote", "input": {}, "expect": [["offers", "count=", 0], ["rejections[productId=464306].code", "=", "CUTOFF_PASSED"]] }]
    },
    {
      "id": "AC11", "title": "Pieces for a volume product are not guessed", "rubric": ["exceptions 15", "controls 20"],
      "given": { "draft": { "category": "10400", "claims": ["FREE_FROM_LACTOSE"], "quantity": { "value": 1000, "unit": "pcs" }, "deliverBy": "2026-11-16" } },
      "steps": [{ "call": "quote", "input": {}, "expect": [["offers", "count=", 0], ["rejections[productId=464306].code", "=", "NOT_CONVERTIBLE"]] }]
