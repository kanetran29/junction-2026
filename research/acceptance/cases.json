{
  "about": "Black-box acceptance cases for the Trusted Trade Gateway. Expected values come from scripts/acceptance/oracle.py on recordings/replies_2026-11-16.json (recorded Fri 13 Nov 21:08 +02:00). Local only: contains Valio challenge data.",
  "defaults": {
    "clock": "2026-11-13T21:10:00+02:00",
    "replay": "replies_2026-11-16",
    "buyer": "hotel-a",
    "mandate": { "perOrder": { "auto": 500, "hard": 5000 }, "perDay": { "auto": 1500, "hard": 10000 }, "reliabilityFloor": 0.9, "approver": "Kitchen manager" }
  },
  "matcher": "Each expect item is [path, op, value]. ops: '=', '!=', 'contains', 'not_contains', '>=', '<=', 'count=', 'matches' (regex). Paths: dot/index paths into the JSON reply; 'rejections[productId=X].code' selects by field.",
  "cases": [
    {
      "id": "AC01", "title": "Brief example end to end", "rubric": ["e2e 30", "need 20", "controls 20"],
      "steps": [
        { "call": "interpret", "input": { "text": "I need 1,000 litres of lactose-free milk by Monday. Find an option that meets our requirements based on price and availability." },
          "expect": [["draft.category", "=", "10400"], ["draft.claims", "contains", "FREE_FROM_LACTOSE"], ["draft.quantity.value", "=", 1000], ["draft.quantity.unit", "=", "l"], ["draft.deliverBy", "=", "2026-11-16"]] },
        { "call": "confirm_draft", "input": { "fill": { "fatLevel": "any" } }, "expect": [["draft.status", "=", "confirmed"]] },
        { "call": "quote", "input": {}, "expect": [["offers[0].lines[0].productId", "=", "464306"], ["offers[0].lines[0].salesUnits", "=", 1000], ["offers[0].netCents", "=", 101000], ["offers[0].grossCents", "=", 114635]] },
        { "call": "place_order", "input": { "offer": 0, "agentReason": "Cheapest lactose-free milk that arrives Monday." },
          "expect": [["state", "=", "HELD"], ["decision.outcome", "=", "NEEDS_APPROVAL"], ["decision.reasons[*].code", "contains", "OVER_ORDER_AUTO"], ["approvalUrl", "matches", "^https?://"]] },
        { "call": "approve", "input": {}, "expect": [["state", "=", "ACCEPTED"]] },
        { "call": "get_receipt", "input": {}, "expect": [["text", "contains", "464306"], ["text", "contains", "1,000"], ["text", "contains", "1,010.00"], ["text", "contains", "1,146.35"], ["text", "contains", "Kitchen manager"]] }
      ]
    },
    {
      "id": "AC02", "title": "Search by attributes, not names, and no Valio calls", "rubric": ["need 20", "openness 15"],
      "steps": [
        { "call": "search_products", "input": { "category": "10400", "claims": ["FREE_FROM_LACTOSE"] },
          "expect": [["products", "count=", 35], ["products[*].category", "not_contains", "52201"], ["products[*].id", "contains", "464306"], ["products[*].id", "not_contains", "466215"], ["valioCalls", "=", 0]] }
      ]
    },
    {
      "id": "AC03", "title": "Quote asks Valio only about the shortlist and types every rejection", "rubric": ["need 20", "exceptions 15", "openness 15"],
      "given": { "draft": { "category": "10400", "claims": ["FREE_FROM_LACTOSE"], "quantity": { "value": 1000, "unit": "l" }, "deliverBy": "2026-11-16" } },
      "steps": [
        { "call": "quote", "input": {}, "expect": [
          ["valioCalls", "<=", 2],
          ["rejections[productId=463038].code", "=", "CUTOFF_PASSED"],
          ["rejections[productId=464440].code", "=", "NOT_ORDERABLE"],
          ["rejections[productId=464237].code", "=", "SUBTYPE_MISMATCH"],
          ["rejections[productId=477050].code", "=", "SUBTYPE_MISMATCH"],
          ["rejections[productId=463380].code", "=", "SUBTYPE_MISMATCH"],
          ["rejections[productId=463203].code", "=", "SUBTYPE_MISMATCH"],
          ["offers[*].lines[*].productId", "not_contains", "463038"],
          ["count(rejections[code=CUTOFF_PASSED])", "=", 20]
        ] }
      ]
    },
    {
      "id": "AC04", "title": "Units, money and quote expiry", "rubric": ["need 20", "e2e 30"],
      "given": { "draft": { "category": "10400", "claims": ["FREE_FROM_LACTOSE"], "quantity": { "value": 1000, "unit": "l" }, "deliverBy": "2026-11-16" } },
      "steps": [
        { "call": "quote", "input": {}, "expect": [
          ["offers[0].lines[0].contentPerSalesUnit", "=", 1], ["offers[0].lines[0].contentUnit", "=", "l"], ["offers[0].overage", "=", 0],
          ["offers[0].lines[0].taxRate", "=", 13.5], ["offers[0].closingTime", "=", "2026-11-15T17:00:00+02:00"],
          ["expiresAt", "=", "2026-11-13T21:40:00+02:00"]
        ] }
      ]
    },
    {
