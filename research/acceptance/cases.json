        ] },
        { "call": "place_order", "input": { "offer": 0 }, "expect": [["state", "=", "HELD"], ["decision.reasons[*].code", "contains", "SHORTFALL"]] }
      ]
    },
    {
      "id": "AC07", "title": "Delivery by Saturday cannot be met", "rubric": ["exceptions 15"],
