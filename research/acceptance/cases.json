        { "call": "quote", "input": {}, "expect": [
          ["offers[0].lines[0].productId", "=", "472673"], ["offers[0].filled", "=", 150], ["offers[0].netCents", "=", 115500], ["offers[0].estimate", "=", true],
          ["offers[*].lines[0].productId", "contains", "462281"], ["offers[productId=462281].filled", "=", 154], ["offers[productId=462281].netCents", "=", 118580]
