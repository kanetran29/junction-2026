        { "call": "place_order", "input": { "offer": 0 }, "expect": [["state", "=", "HELD"], ["decision.reasons[*].code", "contains", "PACK_SIZE_CHANGED"], ["decision.reasons[*].code", "contains", "OVER_ORDER_AUTO"]] }
      ]
    },
    {
