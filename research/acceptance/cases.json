      "steps": [{ "call": "quote", "input": {}, "expect": [["rejections[productId=470863].code", "=", "NEW_ALLERGEN"], ["rejections[productId=470863].detail", "contains", "AW"], ["offers[*].lines[*].productId", "not_contains", "470863"]] }]
